# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB connection string (e.g., mongodb+srv://user:pass@cluster.mongodb.net/blockmatch).
# Optional: Defaults to an auto-configured in-memory MongoDB server if not provided.
MONGODB_URI="mongodb://localhost:27017/blockmatch"

# JWT_SECRET: Secret key used to sign JWT authentication tokens for user sessions.
JWT_SECRET="blockmatch-super-secret-jwt-key-2026"

# FAUCETPAY_API_KEY: Your FaucetPay merchant API key for real crypto payouts.
# Obtain from https://faucetpay.io/merchant/api
FAUCETPAY_API_KEY=2a20706b791a5034727c2efc41d2893703d1b8775f06868a5c57bbd1416cf6e3

# FAUCETPAY_WEBHOOK_SECRET: Your FaucetPay webhook/IPN secret code for verifying callbacks.
FAUCETPAY_WEBHOOK_SECRET=61b1f3839dc409418cb64bb8ea778c3540a5a7349ff6599dc05fd1ed1e113469

# FAUCETPAY_CURRENCY: Target crypto currency (e.g., BTC, LTC, DOGE, USDT).
FAUCETPAY_CURRENCY=BTC

# CWALLET_API_KEY: Your Cwallet merchant API key for USDT / multi-currency payouts.
CWALLET_API_KEY=
